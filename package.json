{
  "name": "genba-anno",
  "version": "0.1.0",
  "private": true,
  "description": "現場向け学習データ作成アノテーションツール（bbox / ポリゴン / マグネットライン）",
  "license": "MIT",
  "author": "GenbaAnno contributors",
  "main": "out/main/main.js",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml",
    "dist:dir": "electron-vite build && electron-builder --config electron-builder.yml --dir"
  },
  "dependencies": {
    "fast-png": "^8.0.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "electron@44.0.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  }
}
